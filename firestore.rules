rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read: isSelf(uid) || isAdmin();
      allow create: isSelf(uid);
      allow update: isSelf(uid) && request.resource.data.role == resource.data.role;
      allow delete: isSelf(uid);
    }

    match /app_config/{doc} {
      allow read: signedIn();
      allow write: isAdmin();
    }

    match /drivers/{driverId} {
      allow read: signedIn();
      allow write: isAdmin();
    }

    match /stations/{stationId} {
      allow read: signedIn();
      allow write: isAdmin();
    }

    match /rides/{rideId} {
      allow create: signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /payments/{paymentId} {
      allow read: signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: isAdmin();
    }

    match /thoughts/{thoughtId} {
      allow read: signedIn();
      allow create: signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: signedIn() && resource.data.userId == request.auth.uid;
      // Authors may edit their own text; anyone signed in may only touch the
      // like fields (the app updates them via a like-once-per-user transaction).
      allow update: signedIn() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount'])
      );
    }

    match /news/{articleId} {
      allow read: signedIn();
      allow write: isAdmin();
    }

    match /thought_reports/{reportId} {
      allow create: signedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: isAdmin();
    }

    match /news_reports/{reportId} {
      allow create: signedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: isAdmin();
    }
  }
}
